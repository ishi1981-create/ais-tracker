const WebSocket = require('ws');

const AISSTREAM_API_KEY = "27870ec7341ee84bc9f07d5fd8c200a99c2af6e2";

// Codespaces内で起動するWebSocketサーバー（ポート8080）
const wss = new WebSocket.Server({ port: 8080 });
console.log("WebSocket Server running on port 8080");

function connectAIS() {
  const aisSocket = new WebSocket("wss://stream.aisstream.io/v0/stream");

  aisSocket.on("open", () => {
    console.log("AISStream 接続成功");
    const subscriptionMessage = {
      APIKey: AISSTREAM_API_KEY,
      BoundingBoxes: [
        [[33.0, 131.5], [35.5, 136.0]] // 瀬戸内海〜大阪湾周辺
      ],
      FilterMessageTypes: ["PositionReport", "ShipStaticData"]
    };
    aisSocket.send(JSON.stringify(subscriptionMessage));
  });

  aisSocket.on("message", (data) => {
    wss.clients.forEach((client) => {
      if (client.readyState === WebSocket.OPEN) {
        client.send(data.toString());
      }
    });
  });

  aisSocket.on("close", () => {
    console.log("AISStream 切断。5秒後に再接続...");
    setTimeout(connectAIS, 5000);
  });
  aisSocket.on("error", (err) => console.error(err));
}

connectAIS();
